<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- NO INTERNET, NO external storage, NO read permission, NO exported workers. -->
    <application android:name=".ProbeApp" android:label="B1 Disposable Storage Probe"
        android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".SlotA" android:process=":slotA" android:exported="false"/>
        <activity android:name=".SlotB" android:process=":slotB" android:exported="false"/>
        <activity android:name=".MainProbe" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
